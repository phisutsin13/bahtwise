# Bahtwise — environment variables
#
# The app is fully usable in demo mode without these values. Username/password
# and magic-link sign-in stay disabled until a real Supabase project is
# configured. Copy this file to `.env.local` and fill in your project values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to resolve a username to its email during password sign-in.
# Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
